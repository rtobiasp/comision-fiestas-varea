# Plantilla de referencia (no se crea ningún .env en el host).
# El backend .NET NO usa .env:
#   - Desarrollo local -> dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;..."
#   - Producción -> inyectar ConnectionStrings__DefaultConnection desde el entorno del contenedor
#     o el gestor de secretos (Docker Secrets, Vault, Azure Key Vault, etc.).
# Las variables de abajo son solo para sobreescribir los defaults de docker-compose.yml
# exportándolas en el shell (p. ej. $env:POSTGRES_PASSWORD="..." en PowerShell).
# No crear archivos .env con secretos.
# PostgreSQL (servicio "postgres" del docker-compose.yml)
POSTGRES_DB=fiestas_varea
POSTGRES_USER=changeme_user
POSTGRES_PASSWORD=changeme_password
POSTGRES_PORT=5432

# pgAdmin (solo con --profile tools)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050
