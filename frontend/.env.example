# Copiar a .env.local para desarrollo local. No commitear .env.local.
# NEXT_PUBLIC_* -> expuesto al browser. API_INTERNAL_URL -> solo Server Components / SSR.

NEXT_PUBLIC_API_URL=http://localhost:5243
API_INTERNAL_URL=http://localhost:5243

# Solo desarrollo local: la API redirige a https con certificado autofirmado de dotnet dev-certs.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Solo usado por `pnpm gen:api` (scripts/gen-api.mjs).
OPENAPI_URL=http://localhost:5243/openapi/v1.json
